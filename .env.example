# Application mode: dev locally; prod for deployed environments.
APP_ENV=dev

# FalkorDB connection used by the current single-graph compatibility layer.
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
# Deprecated after the workspace migration; retained for the legacy graph.
FALKORDB_GRAPH=graphmind
# Set true only when the FalkorDB provider requires TLS.
FALKORDB_TLS=false

# Authentication settings for the planned workspace-auth phase.
# JWT_SECRET must be at least 32 characters in production.
JWT_SECRET=
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated origins. Do not use a wildcard in production.
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# deterministic works offline. Other supported values are openai and groq.
LLM_PROVIDER=deterministic
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
CHAT_MODEL=gpt-4o-mini
EXTRACTION_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
MEMORY_CONTEXT_TOKENS=2500
MAX_MESSAGE_CHARS=8000
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_API_PER_MIN=120
LLM_TIMEOUT_S=60
AGENT_RUN_TIMEOUT_S=120

# inproc for a single backend process; redis is intended for scale-out.
EVENT_BUS=inproc
# Optional search provider for the planned Research agent.
TAVILY_API_KEY=

# Frontend public URLs are compiled into the Next.js image at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Deprecated compatibility variables. USER_ID remains active in this phase.
# ALLOW_LEGACY_USER_HEADER becomes active when JWT auth is introduced.
LLM_API_KEY=
LLM_MODEL=
USER_ID=demo-user
ALLOW_LEGACY_USER_HEADER=false
